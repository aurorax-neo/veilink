FROM alpine:3.23

ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG SOURCE_URL=unknown

RUN apk add --no-cache ca-certificates tzdata sqlite su-exec curl \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo Asia/Shanghai > /etc/timezone \
    && mkdir -p /data /opt/veilink-web /usr/local/share/doc/veilink \
    && adduser -D -u 65532 -g 65532 veilink \
    && chown -R veilink:veilink /data

ENV TZ=Asia/Shanghai

LABEL org.opencontainers.image.title="veilink" \
      org.opencontainers.image.description="Veilink master/server/client with pre-bundled web UI" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.source="${SOURCE_URL}"

# docker-bin is prepared by the build-binaries job. The image stage never
# invokes a compiler and only selects the native binary for TARGETARCH.
COPY docker-bin/${TARGETARCH}/veilink /usr/local/bin/veilink
COPY docker-web/ /opt/veilink-web/
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/local/share/doc/veilink/
COPY docker-entrypoint.sh docker-healthcheck.sh /usr/local/bin/

RUN chmod 755 /usr/local/bin/veilink /usr/local/bin/docker-entrypoint.sh /usr/local/bin/docker-healthcheck.sh

WORKDIR /data
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["master"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/usr/local/bin/docker-healthcheck.sh"]
